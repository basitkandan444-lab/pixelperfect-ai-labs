# Example environment configuration. Copy to `.env` for local development.
# `.env` is git-ignored — never commit real values.
#
# All variables below are OPTIONAL: the app boots without them. Malformed values
# (wrong format) fail validation in src/lib/env.ts.
#
# NOTE: Image enhancement runs entirely in the user's browser (WebGPU/WebGL/CPU
# via OffscreenCanvas + Web Workers). There is NO AI gateway key, no hosted
# inference endpoint and no usage credits — so no server secret is required.



# --- Client config (VITE_*, shipped in the browser bundle — public) ----------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=

# Microsoft Clarity project ID
VITE_CLARITY_ID=

# Extra Google Search Console verification token
VITE_GSC_VERIFICATION=


# --- Server secrets (never shipped to the browser) --------------------------
# Required for the Premium ($0.99/mo) upgrade flow (Stripe Checkout + webhook
# activation). The app boots and the Free plan works fully without these; the
# Upgrade UI self-disables (see /api/public/stripe/status) when they're absent
# instead of failing at checkout time.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional: force the origin used to build Stripe success/cancel/return URLs.
# Only needed if the platform's edge proxy does not set X-Forwarded-Proto/Host
# reliably for this deployment target.
PUBLIC_APP_ORIGIN=
